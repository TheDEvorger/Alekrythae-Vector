/* Existing Core v0.1.2-R3. No Core modification required. */
window.__AV_EMBEDDED_ASSETS={"icons/close.svg":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjYmRlZmZmIiBzdHJva2Utd2lkdGg9IjEuNSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJtNSA1IDE0IDE0TTE5IDUgNSAxOSIvPjwvc3ZnPg==","icons/export.svg":"data:image/svg+xml;base64,","icons/import.svg":"data:image/svg+xml;base64,"};
(function(){
'use strict';
window.AV=window.AV||{};
const AV=window.AV;
AV.VERSION='0.1.0';
AV.BUILD='VisionCortex-VTracer-1.0-PhotoStacked-MaxColors';
AV.now=()=>typeof performance!=='undefined'?performance.now():Date.now();
})();

(function(){
'use strict';
const AV=window.AV;
AV.$=(s,r=document)=>r.querySelector(s);
AV.$$=(s,r=document)=>Array.from(r.querySelectorAll(s));
AV.clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
AV.formatBytes=n=>{if(!Number.isFinite(n)||n<=0)return'0 B';const u=['B','KB','MB','GB'];const i=Math.min(3,Math.floor(Math.log(n)/Math.log(1024)));return`${(n/1024**i).toFixed(i?1:0)} ${u[i]}`};
AV.escapeHtml=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
AV.yieldUI=()=>new Promise(r=>setTimeout(r,0));
AV.now=()=>globalThis.performance?.now?.()??Date.now();
AV.baseName=()=>((AV.state.file&&AV.state.file.name)||'Alekrythae-Vector').replace(/\.[^.]+$/,'').replace(/[^\p{L}\p{N}._-]+/gu,'_');
AV.downloadBlob=(blob,name)=>{const a=document.createElement('a');const url=URL.createObjectURL(blob);a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2500)};
AV.canvasBlob=(c,type='image/png')=>new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error('Failed to create canvas blob.')),type));
})();

(function(){
'use strict';
const AV=window.AV;
let shown=false;
AV.fatal=function(err){if(shown)return;shown=true;const t=AV.escapeHtml(err?.stack||err?.message||err||'Unknown error');document.body.innerHTML=`<div style="min-height:100vh;display:grid;place-items:center;background:#01040a;color:#eaf7ff;font:13px Segoe UI;padding:32px"><div style="max-width:900px;border:1px solid rgba(255,105,130,.38);background:#07101b;padding:24px;clip-path:polygon(0 12px,12px 0,100% 0,100% calc(100% - 12px),calc(100% - 12px) 100%,0 100%)"><b>Ałek’ryŧhæ Vector could not be started.</b><pre style="white-space:pre-wrap;color:#ffb7c3">${t}</pre></div></div>`};
window.addEventListener('error',e=>AV.fatal(e.error||e.message));
window.addEventListener('unhandledrejection',e=>AV.fatal(e.reason));
})();

(function(){
'use strict';
const AV=window.AV;
AV.CONFIG={
  previewDebounce:420,
  hugeSvgRenderLimit:256*1024*1024,
  sliderMax:1024,
  enginePackage:'@visioncortex/vtracer@1.0.0-alpha.3',
  engineTransport:'http://127.0.0.1:17324',
  defaults:{
    mode:'color', quality:820, colors:768, threshold:512,
    detail:820, smoothing:760, cleanup:720,
    background:false, invert:false,
    zoom:1, panX:0, panY:0
  }
};
AV.qualityName=v=>v>=1000?'RAW':v>=850?'EXTREME':v>=700?'ULTRA':v>=520?'HIGH':v>=280?'BALANCED':'FAST';
})();

(function(){
'use strict';
const AV=window.AV;
AV.state={
  ...AV.CONFIG.defaults,
  file:null,image:null,imageUrl:'',inputPath:'',
  busy:false,preview:null,lastSuccessfulPreview:null,previewKey:'',renderTimer:0,serial:0,adjusting:false,pendingTrace:false,
  introDone:false,lastTraceMs:0,
  engineStatus:'native-local',
  perf:{cores:navigator.hardwareConcurrency||4,memory:navigator.deviceMemory||0,gpuPreference:''}
};
})();

(function(){
'use strict';
const AV=window.AV;
const host=window.__alekAssets||{};
const embedded=window.__AV_EMBEDDED_ASSETS||{};
const uniq=xs=>[...new Set(xs.filter(Boolean))];

// Canonical order: exact BlueMoon injected by Core -> local branding if available -> Core Resources -> asset next to the app.
AV.ASSETS={
 moon:uniq([
   host.moon,
   embedded['branding/BlueMoon.png'],embedded['branding/Bluemoon.png'],embedded['branding/Bluemoon(1).png'],
   'https://alek-engine.local/BlueMoon.png','https://alek-engine.local/Bluemoon.png','https://alek-engine.local/Bluemoon(1).png',
   'https://alek-assets.local/BlueMoon.png','https://alek-assets.local/Bluemoon.png','https://alek-assets.local/Bluemoon(1).png',
   'https://alek-assets.local/Resources/BlueMoon.png','https://alek-assets.local/Resources/Bluemoon.png','https://alek-assets.local/Resources/Bluemoon(1).png',
   'https://alek-assets.local/assets/branding/BlueMoon.png','https://alek-assets.local/assets/branding/Bluemoon(1).png'
 ]),
 wordmark:uniq([
   host.wordmark,
   embedded['branding/Alekrythae.png'],
   'https://alek-engine.local/Alekrythae.png',
   'https://alek-assets.local/Alekrythae.png','https://alek-assets.local/Resources/Alekrythae.png','https://alek-assets.local/assets/branding/Alekrythae.png'
 ]),
 embedded
};

AV.tryUrls=(img,urls,{fallback='',className='ok'}={})=>new Promise(resolve=>{
  if(!img){resolve({ok:false,url:''});return;}
  let i=0,settled=false;
  const done=(ok,url)=>{if(settled)return;settled=true;if(ok&&className)img.classList.add(className);resolve({ok,url:url||''})};
  const next=()=>{
    if(i>=urls.length){
      if(fallback){img.onload=()=>done(false,fallback);img.onerror=()=>done(false,'');img.src=fallback;}
      else done(false,'');
      return;
    }
    const url=urls[i++];
    img.onload=()=>done(true,url);
    img.onerror=next;
    img.src=url;
  };
  next();
});
})();

(function(){
'use strict';
const css=`
:root{--safe:10px;--bg:#020811;--panel:#06111d;--line:rgba(104,202,244,.13);--line2:rgba(104,202,244,.28);--text:#c8dbe6;--muted:#5c788d;--cyan:#69ddff;--danger:#ef9ca5}
*{box-sizing:border-box;min-width:0}
html,body{position:fixed;inset:0;width:100vw;height:100vh;margin:0;padding:0;overflow:hidden;background:#020811;color:var(--text);font-family:Segoe UI,Arial,sans-serif}
body{user-select:none}
button,input{font:inherit}
.av-app{position:fixed;inset:0;width:100vw;height:100vh;height:100dvh;margin:0;padding:0;display:grid;grid-template-rows:42px minmax(0,1fr) 20px;background:radial-gradient(circle at 55% 16%,rgba(15,65,95,.13),transparent 34%),#020811;overflow:hidden}
.topbar{display:grid;grid-template-columns:minmax(130px,auto) 1fr auto;align-items:center;gap:8px;padding:0 var(--safe) 0 8px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,rgba(5,17,29,.98),rgba(3,11,20,.97));overflow:hidden}
.brand{display:flex;align-items:center;gap:8px;overflow:hidden}.top-wordmark{height:21px;max-width:116px;object-fit:contain;display:none}.top-wordmark.ok{display:block}.brand-fallback{font:15px Georgia,serif;color:#e0edf2;white-space:nowrap}.top-wordmark.ok+.brand-fallback{display:none}.brand i{font:normal 7px Georgia,serif;letter-spacing:.25em;color:#55788e;border-left:1px solid var(--line);padding-left:8px;white-space:nowrap}
.top-actions{grid-column:3;display:flex;align-items:center;justify-content:flex-end;gap:5px;overflow:hidden;white-space:nowrap}.mode-switch{display:flex;border:1px solid rgba(96,199,239,.13);background:#04111c;padding:2px;flex:none}.btn,.mode-btn{height:29px;border:1px solid rgba(96,199,239,.15);background:#071522;color:#8ba9ba;padding:0 8px;display:flex;align-items:center;justify-content:center;gap:5px;cursor:pointer;transition:.14s;white-space:nowrap;font-size:11px;flex:none}.mode-switch .mode-btn{height:25px;border:0;background:transparent;padding:0 9px}.mode-switch .mode-btn.active{background:#0a2b40;color:#e7fbff;box-shadow:inset 0 -1px #6ce1ff}.btn img{width:12px;height:12px;opacity:.82}.btn:hover,.mode-btn:hover{border-color:var(--line2);color:#dcf6ff;background:#0a2133}.btn.primary{border-color:rgba(89,218,255,.34);background:linear-gradient(180deg,#0c3550,#082439);color:#d7f5ff}.btn:disabled{opacity:.3;cursor:default}.btn.danger{color:#c8949b}.btn.danger:hover{color:#ffe1e4;border-color:rgba(255,126,141,.34);background:#241019}
.studio{min-height:0;display:grid;grid-template-columns:clamp(190px,13vw,220px) minmax(0,1fr) clamp(260px,19vw,290px);gap:1px;background:var(--line);padding:0 var(--safe) var(--safe) 0;overflow:hidden}.source-panel,.settings-panel,.result-panel{min-width:0;min-height:0;overflow:hidden;background:linear-gradient(180deg,#05111d,#030b14)}.source-panel{display:grid;grid-template-rows:36px minmax(0,1fr) 30px}.settings-panel{display:grid;grid-template-rows:36px minmax(0,1fr)}.result-panel{display:grid;grid-template-rows:40px minmax(0,1fr);background:#030a12}
.panel-title,.result-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 10px;border-bottom:1px solid rgba(96,199,239,.09);background:rgba(7,20,33,.95);overflow:hidden}.panel-title>span,.result-head>div>span{font:8px Georgia,serif;letter-spacing:.18em;color:#a9c2d0;white-space:nowrap}.panel-title small,.result-head small{font:7px Consolas,monospace;color:#4d6d82;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.panel-title small{max-width:44%}.source-title{gap:5px}.source-pick{height:22px;flex:none;padding:0 7px;border:1px solid rgba(93,207,248,.20);background:#071827;color:#8cb5c8;font:7px Georgia,serif;letter-spacing:.08em;cursor:pointer;white-space:nowrap}.source-pick:hover{border-color:rgba(93,207,248,.42);color:#d5f6ff;background:#0a2133}.result-head>div:first-child{display:flex;align-items:baseline;gap:9px;overflow:hidden}.result-head small{max-width:180px}.preview-badge{font:6px Consolas,monospace;letter-spacing:.08em;color:#64bad5;border:1px solid rgba(90,207,244,.18);padding:3px 5px;white-space:nowrap;flex:none}
.source-card{position:relative;margin:6px;border:1px solid rgba(94,196,239,.12);background:radial-gradient(circle at 50% 44%,rgba(16,59,84,.15),transparent 48%),#030b14;overflow:hidden;clip-path:polygon(0 9px,9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%)}.source-card.drag{border-color:#58d8ff}.source-tip{display:flex;align-items:center;padding:0 9px;border-top:1px solid rgba(96,199,239,.07);font-size:7px;color:#426277;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.viewer{position:relative;min-height:0;overflow:hidden;background:radial-gradient(circle at 50% 48%,rgba(11,39,57,.18),transparent 44%),#020810}.result-viewer:before{content:"";position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(78,145,179,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(78,145,179,.025) 1px,transparent 1px);background-size:80px 80px;mask-image:radial-gradient(circle,#000 20%,transparent 78%)}
.empty{position:absolute;inset:0;display:grid;place-content:center;justify-items:center;gap:8px;text-align:center;color:#58788d;padding:16px}.empty strong{font:16px Georgia,serif;color:#9ebdcb;font-weight:400}.empty span{font-size:8px;line-height:1.5;max-width:300px}.mini-moon-shell{width:88px;height:88px;display:grid;place-items:center;margin-bottom:4px}.moon-mini{max-width:82px;max-height:82px;object-fit:contain;filter:drop-shadow(0 0 14px rgba(31,172,255,.34))}.mini-pick{margin-top:7px;height:27px;padding:0 10px;border:1px solid rgba(93,207,248,.20);background:#071827;color:#8cb5c8;font:8px Georgia,serif;letter-spacing:.13em;cursor:pointer}.preview-mark{position:relative;width:118px;height:118px;display:grid;place-items:center;margin-bottom:3px}.preview-mark img{max-width:86px;max-height:86px;object-fit:contain;filter:drop-shadow(0 0 18px rgba(31,172,255,.26))}.preview-ring{position:absolute;inset:4px;border:1px solid rgba(85,198,242,.12);border-radius:50%}.scene{position:absolute;inset:10px;display:none;align-items:center;justify-content:center;overflow:hidden}.source-card .scene{inset:7px}.scene.show{display:flex}.scene img{max-width:100%;max-height:100%;object-fit:contain;transform-origin:center center;will-change:transform}.source-scene,.result-scene{cursor:grab}
.settings-body{min-height:0;overflow-y:auto;overflow-x:hidden;padding:7px 12px 8px 10px;scrollbar-width:thin;scrollbar-color:#14374f transparent}.setting{display:grid;grid-template-columns:minmax(0,1fr) 46px;gap:6px;align-items:end;padding:8px 0;border-bottom:1px solid rgba(91,194,236,.055);overflow:hidden}.setting-copy{overflow:hidden}.setting-copy label{display:block;font:10px Georgia,serif;color:#b7cfdb;white-space:nowrap}.setting-copy span{display:block;margin-top:2px;color:#4d6c81;font-size:7px;line-height:1.3;padding-right:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.setting>b{font:8px Consolas,monospace;color:#6adfff;text-align:right;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.range{grid-column:1/3;appearance:none;width:100%;max-width:100%;height:15px;background:transparent;min-width:0}.range::-webkit-slider-runnable-track{height:2px;background:linear-gradient(90deg,#258db6,#16384f)}.range::-webkit-slider-thumb{appearance:none;width:11px;height:11px;margin-top:-4.5px;border-radius:50%;background:#e2faff;border:1px solid #5fdcff;box-shadow:0 0 8px rgba(78,210,255,.42)}.setting-divider{height:1px;background:rgba(91,194,236,.09);margin:9px 0}.toggle{width:100%;min-height:42px;border:1px solid rgba(91,197,238,.10);background:#06131f;color:#8eaaba;padding:7px 8px;display:grid;grid-template-columns:12px minmax(0,1fr);gap:8px;align-items:center;text-align:left;cursor:pointer;margin:6px 0;overflow:hidden}.toggle>span{width:10px;height:10px;border:1px solid #41657c;background:#07131d}.toggle div{overflow:hidden}.toggle b{display:block;font:10px Georgia,serif;color:#a9c5d3;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.toggle small{display:block;margin-top:2px;font-size:7px;color:#48687e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.toggle.on{border-color:rgba(61,207,246,.30);background:#082033}.toggle.on>span{background:#65e1ff;box-shadow:0 0 7px #3ec7ed}.quality-hint{margin:2px 0 8px;padding:6px 7px;border:1px solid rgba(95,205,244,.09);background:rgba(5,18,29,.56);font-size:6px;line-height:1.35;color:#496b80;overflow:hidden}.quality-hint b{display:block;color:#67cfea;font:7px Consolas,monospace;margin-bottom:3px}.quality-hint span{display:block;white-space:normal;overflow-wrap:anywhere}.settings-note{margin-top:10px;padding:8px;border-left:2px solid rgba(92,211,249,.25);background:rgba(8,27,42,.45);font-size:7px;line-height:1.45;color:#506f83;overflow-wrap:anywhere}
.busy{position:absolute;inset:0;display:none;place-items:center;background:rgba(1,7,13,.48);backdrop-filter:blur(2px)}.busy.show{display:grid}.busy-card{width:min(230px,80%);padding:15px;border:1px solid rgba(92,219,255,.24);background:#061522}.busy-card b{display:block;font:9px Georgia,serif;letter-spacing:.18em;color:#bfeefe}.busy-card span{display:block;margin-top:7px;font-size:8px;color:#57778d}.progress{height:2px;background:#0d2739;margin-top:12px;overflow:hidden}.progress i{display:block;height:100%;width:0;background:#55ddff}.statusbar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 var(--safe) 0 8px;border-top:1px solid rgba(91,205,255,.07);background:#020811;color:#49687c;font-size:7px;overflow:hidden}.statusbar>*{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.stats{font-family:Consolas,monospace;text-align:right}.toast{position:fixed;left:50%;bottom:28px;transform:translate(-50%,12px);opacity:0;pointer-events:none;padding:8px 12px;background:#082033;border:1px solid rgba(93,218,255,.28);color:#c8f3ff;font-size:9px;transition:.18s;z-index:500}.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:1180px){.studio{grid-template-columns:180px minmax(0,1fr) 244px}.brand i{display:none}.top-wordmark{max-width:98px}.btn,.mode-btn{padding:0 6px;font-size:10px}.mode-switch .mode-btn{padding:0 7px}.settings-body{padding-right:10px}.result-head small{max-width:120px}}
@media(max-width:940px){.studio{grid-template-columns:minmax(0,1fr) 236px}.source-panel{display:none}.brand{min-width:100px}.top-wordmark{max-width:90px}.btn,.mode-btn{font-size:9px}.btn{padding:0 5px}}
.splash{position:fixed;inset:0;z-index:1000;background:radial-gradient(circle at 50% 43%,#07182a 0,#020913 34%,#01050b 72%);display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .5s ease}.splash.hide{opacity:0;pointer-events:none}.splash-vignette{position:absolute;inset:0;box-shadow:inset 0 0 180px #000}.moon-lock{position:relative;width:min(43vw,520px);aspect-ratio:1;margin-top:-4vh;display:grid;place-items:center}.splash-moon{position:absolute;left:50%;top:50%;width:68%;height:68%;transform:translate(-50%,-50%);object-fit:contain;opacity:0;animation:moonIn .9s .15s ease forwards;filter:drop-shadow(0 0 25px rgba(28,154,255,.42))}.moon-orbit{position:absolute;left:50%;top:50%;border:1px solid rgba(77,183,238,.18);border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}.orbit-a{width:82%;height:82%}.orbit-b{width:94%;height:94%;border-color:rgba(77,183,238,.08)}.moon-cross{position:absolute;left:50%;top:50%;background:rgba(79,185,235,.13);transform:translate(-50%,-50%)}.moon-cross.x{width:100%;height:1px}.moon-cross.y{width:1px;height:100%}.splash-mark{position:relative;margin-top:-7vh;display:flex;flex-direction:column;align-items:center;gap:6px}.splash-wordmark{max-width:250px;max-height:54px;display:none}.splash-wordmark.ok{display:block}.splash-brand-fallback{font:27px Georgia,serif;color:#e2eef2}.splash-wordmark.ok+.splash-brand-fallback{display:none}.splash-mark span{font:9px Georgia,serif;letter-spacing:.55em;color:#6f9db8}.top-wordmark,.splash-wordmark{filter:drop-shadow(0 0 8px rgba(131,216,255,.14))}@keyframes moonIn{from{opacity:0;transform:translate(-50%,-50%) scale(.92)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
@media(prefers-reduced-motion:reduce){.splash-moon{animation:none;opacity:1}}
`;
const style=document.createElement('style');style.textContent=css;document.head.appendChild(style);
})();

(function(){
'use strict';
const AV=window.AV,A=AV.ASSETS.embedded;
const icon=n=>A[`icons/${n}.svg`]||'';
const html=`
<div class="splash" id="splash" role="presentation">
  <div class="splash-vignette"></div>
  <div class="moon-lock">
    <div class="moon-orbit orbit-a"></div><div class="moon-orbit orbit-b"></div><div class="moon-cross x"></div><div class="moon-cross y"></div>
    <img class="splash-moon" alt="Ałek’ryŧhæ Mavi Ay" draggable="false">
  </div>
  <div class="splash-mark"><img class="splash-wordmark" alt="Ałek’ryŧhæ" draggable="false"><div class="splash-brand-fallback">Ałek’ryŧhæ</div><span>VECTOR</span></div>
</div>
<div class="av-app">
  <header class="topbar">
    <div class="brand"><img class="top-wordmark" alt="Ałek’ryŧhæ"><span class="brand-fallback">Ałek’ryŧhæ</span><i>VECTOR</i></div>
    <div class="top-actions">
      <div class="mode-switch" aria-label="SVG mode">
        <button class="mode-btn active" data-mode="color">Color</button>
        <button class="mode-btn" data-mode="mono">Black · White</button>
      </div>
      <button class="btn save primary" disabled><img src="${icon('export')}">Save SVG</button>
      <button class="btn exit-app danger"><img src="${icon('close')}">Exit</button>
    </div>
  </header>

  <main class="studio">
    <aside class="source-panel">
      <div class="panel-title source-title"><span>SOURCE</span><small class="source-info">No image</small><button class="source-pick pick" type="button">CHOOSE FILE</button></div>
      <div class="source-card source-drop">
        <div class="empty source-empty">
          <div class="mini-moon-shell"><img class="moon-mini" alt=""></div>
          <strong>Choose an image</strong>
          <span>PNG · JPG · WEBP · BMP</span>
        </div>
        <div class="scene source-scene"><img class="canvas-source" alt=""></div>
      </div>
      <div class="source-tip">Wheel: zoom · Drag: pan</div>
    </aside>

    <section class="result-panel">
      <div class="result-head">
        <div><span>SVG PREVIEW</span><small class="trace-info">VTracer 1.0 Photo · Stacked</small></div>
        <div class="preview-badge">WYSIWYG</div>
      </div>
      <div class="viewer result-viewer">
        <div class="empty result-empty">
          <div class="preview-mark"><div class="preview-ring"></div><img class="moon-preview" alt=""></div>
          <strong>Your vector appears here</strong>
          <span>Choose an image on the left. The SVG shown in the preview is exactly what will be saved.</span>
        </div>
        <div class="scene result-scene"><img class="canvas-result" alt=""></div>
        <div class="busy"><div class="busy-card"><b>GENERATING SVG</b><span class="busy-stage">preparing</span><div class="progress"><i></i></div></div></div>
      </div>
    </section>

    <aside class="settings-panel">
      <div class="panel-title"><span>SETTINGS</span><small class="mode-label">COLOR</small></div>
      <div class="settings-body">
        <div class="setting color-only"><div class="setting-copy"><label>Colors</label><span>Maximum number of colors</span></div><b class="colors-v"></b><input class="range colors" type="range" min="2" max="1024" step="1"></div>
        <div class="setting mono-only"><div class="setting-copy"><label>Threshold</label><span>Black / white cutoff point</span></div><b class="threshold-v"></b><input class="range threshold" type="range" min="0" max="1024" step="1"></div>
        <div class="setting"><div class="setting-copy"><label>Detail</label><span>Preserve fine shapes and regions</span></div><b class="detail-v"></b><input class="range detail" type="range" min="0" max="1024" step="1"></div>
        <div class="setting"><div class="setting-copy"><label>Curves</label><span>Bézier curve smoothness</span></div><b class="smoothing-v"></b><input class="range smoothing" type="range" min="0" max="1024" step="1"></div>
        <div class="setting"><div class="setting-copy"><label>Cleanup</label><span>Merge tiny unnecessary regions</span></div><b class="cleanup-v"></b><input class="range cleanup" type="range" min="0" max="1024" step="1"></div>
        <div class="setting quality-setting"><div class="setting-copy"><label>Quality</label><span>True quality value from 0–1024</span></div><b class="quality-v"></b><input class="range quality" type="range" min="0" max="1024" step="1"></div>
        <div class="quality-hint"><b class="quality-name">BALANCED</b><span>1024 = RAW · true upper limit · file size is not restricted · maxColors 1024 · simplify 0 · 32 iterations</span></div>

        <div class="setting-divider"></div>
        <button class="toggle background"><span></span><div><b>Remove Background</b><small>Removes the dominant edge-connected background region</small></div></button>
        <button class="toggle invert mono-only"><span></span><div><b>Invert</b><small>Swaps black and white</small></div></button>

        <div class="settings-note">VisionCortex VTracer 1.0 · Photo + Stacked · true maxColors · 1024 = no-compromise fidelity · no embedded raster images.</div>
      </div>
    </aside>
  </main>

  <footer class="statusbar"><span class="status-text">ready</span><span class="stats">Ałek’ryŧhæ Vector v${AV.VERSION}</span></footer>
</div>
<div class="toast"></div>`;
const root=document.createElement('div');root.innerHTML=html;while(root.firstChild)document.body.appendChild(root.firstChild);
})();

(function(){
'use strict';
const AV=window.AV,$=AV.$;
AV.ui={
 setStatus(t){const e=$('.status-text');if(e)e.textContent=t},
 toast(t){const e=$('.toast');e.textContent=t;e.classList.add('show');clearTimeout(AV.ui._toast);AV.ui._toast=setTimeout(()=>e.classList.remove('show'),1900)},
 setBusy(on,stage='preparing'){AV.state.busy=on;$('.busy')?.classList.toggle('show',on);if(stage)$('.busy-stage').textContent=stage;if(!on)$('.progress i').style.width='0%'},
 progress(p,stage){$('.progress i').style.width=`${p}%`;if(stage)$('.busy-stage').textContent=stage}
};
AV.brandReadyPromise=Promise.allSettled([
 AV.tryUrls($('.splash-moon'),AV.ASSETS.moon),
 AV.tryUrls($('.moon-mini'),AV.ASSETS.moon),
 AV.tryUrls($('.moon-preview'),AV.ASSETS.moon),
 AV.tryUrls($('.splash-wordmark'),AV.ASSETS.wordmark),
 AV.tryUrls($('.top-wordmark'),AV.ASSETS.wordmark)
]);
})();

(function(){
'use strict';
const AV=window.AV,$=AV.$;
const splash=$('#splash');
const born=AV.now();
const MIN_SHOW_MS=1750;
const MAX_ASSET_WAIT_MS=950;
AV.dismissSplash=()=>{
  if(AV.state.introDone)return;
  const wait=Math.max(0,MIN_SHOW_MS-(AV.now()-born));
  setTimeout(()=>{
    if(AV.state.introDone)return;
    AV.state.introDone=true;
    splash.classList.add('hide');
    setTimeout(()=>splash?.remove(),560);
  },wait);
};
splash.addEventListener('click',()=>{
  // Clicking does not remove the signature instantly; it only skips after the minimum display time.
  AV.dismissSplash();
});
Promise.race([
  AV.brandReadyPromise||Promise.resolve(),
  new Promise(r=>setTimeout(r,MAX_ASSET_WAIT_MS))
]).finally(AV.dismissSplash);
setTimeout(AV.dismissSplash,2150);
})();

(function(){
'use strict';
const AV=window.AV,$=AV.$,$$=AV.$$;
AV.syncUI=()=>{
 const s=AV.state;
 $$('.mode-btn').forEach(b=>b.classList.toggle('active',b.dataset.mode===s.mode));
 $$('.color-only').forEach(e=>e.style.display=s.mode==='color'?'':'none');
 $$('.mono-only').forEach(e=>e.style.display=s.mode==='mono'?'':'none');
 for(const k of ['colors','threshold','detail','smoothing','cleanup','quality']){const e=$('.'+k);if(e){e.value=s[k];const v=$('.'+k+'-v');if(v)v.textContent=String(s[k])}}
 $('.background')?.classList.toggle('on',s.background);$('.invert')?.classList.toggle('on',s.invert);
 const ml=$('.mode-label');if(ml)ml.textContent=s.mode==='color'?'COLOR':'B/W';const qn=$('.quality-name');if(qn)qn.textContent=AV.qualityName(s.quality);
 $$('.save').forEach(b=>b.disabled=!s.image);
};
})();

(function(){
'use strict';
const AV=window.AV,$=AV.$;
let dragging=false,lastX=0,lastY=0;
function apply(){const t=`translate(${AV.state.panX}px,${AV.state.panY}px) scale(${AV.state.zoom})`;$('.canvas-source').style.transform=t;$('.canvas-result').style.transform=t}
AV.fitScene=()=>{AV.state.zoom=1;AV.state.panX=0;AV.state.panY=0;apply()};
for(const sel of ['.source-scene','.result-scene']){const e=$(sel);e.addEventListener('wheel',ev=>{if(!AV.state.image)return;ev.preventDefault();AV.state.zoom=AV.clamp(AV.state.zoom*(ev.deltaY<0?1.08:.925),.2,6);apply()},{passive:false});e.addEventListener('pointerdown',ev=>{if(!AV.state.image)return;dragging=true;lastX=ev.clientX-AV.state.panX;lastY=ev.clientY-AV.state.panY;e.setPointerCapture(ev.pointerId)});e.addEventListener('pointermove',ev=>{if(!dragging)return;AV.state.panX=ev.clientX-lastX;AV.state.panY=ev.clientY-lastY;apply()});e.addEventListener('pointerup',()=>dragging=false);e.addEventListener('pointercancel',()=>dragging=false)}
})();

(function(){
'use strict';
const AV=window.AV,$=AV.$;

AV.revokeOwnedImageUrl=()=>{
 const u=AV.state.imageUrl;
 if(u&&String(u).startsWith('blob:')){try{URL.revokeObjectURL(u)}catch(_){}}
};

AV.loadExternalDescriptor=function(desc){
 if(!desc?.url){AV.ui.toast('Could not open image: no URL was created.');return}
 if(AV.state.currentWorker){try{AV.state.currentWorker.terminate()}catch(_){}AV.state.currentWorker=null}
 const previousUrl=AV.state.imageUrl;
 const img=new Image();img.decoding='async';AV.ui.setStatus('loading image');
 img.onload=()=>{
   if(previousUrl&&previousUrl!==desc.url&&String(previousUrl).startsWith('blob:')){try{URL.revokeObjectURL(previousUrl)}catch(_){}}
   AV.state.file={name:desc.name||'image',size:Number(desc.size)||0,type:desc.mimeType||desc.type||''};
   AV.state.inputPath=desc.path||'';AV.state.image=img;AV.state.imageUrl=desc.url;AV.state.preview=null;AV.state.previewKey='';
   $('.canvas-source').src=desc.url;$('.source-scene').classList.add('show');$('.source-empty').style.display='none';
   $('.result-empty').style.display='grid';$('.result-scene').classList.remove('show');
   $('.source-info').textContent=`${img.naturalWidth} × ${img.naturalHeight} · ${AV.formatBytes(Number(desc.size)||0)}`;
   AV.fitScene();AV.syncUI();AV.ui.setStatus('adjust settings · waiting to trace');AV.schedulePreview(true);
 };
 img.onerror=()=>{if(String(desc.url).startsWith('blob:')){try{URL.revokeObjectURL(desc.url)}catch(_){}}AV.ui.toast('Could not open image.');AV.ui.setStatus('error')};
 img.src=desc.url;
};

AV.loadLocalFile=function(file){
 if(!file)return;
 const ok=/^image\/(png|jpeg|webp|bmp)$/i.test(file.type||'')||/\.(png|jpe?g|webp|bmp)$/i.test(file.name||'');
 if(!ok){AV.ui.toast('Supported image formats: PNG, JPG, JPEG, WEBP, BMP');return}
 const url=URL.createObjectURL(file);
 AV.loadExternalDescriptor({url,name:file.name,size:file.size,mimeType:file.type||'',path:''});
};

AV.pickImage=async function(){
 AV.cancelTrace();

 // Native <input type=file> is primary: it does not depend on Core bridges,
 // it can be used repeatedly, and blob: URLs keep canvas pixel reads same-origin.
 try{
   const file=await new Promise((resolve,reject)=>{
     const input=document.createElement('input');
     input.type='file';input.accept='.png,.jpg,.jpeg,.webp,.bmp,image/png,image/jpeg,image/webp,image/bmp';
     input.style.display='none';
     let done=false;
     const finish=v=>{if(done)return;done=true;try{input.remove()}catch(_){}resolve(v||null)};
     input.addEventListener('change',()=>finish(input.files?.[0]||null),{once:true});
     window.addEventListener('focus',()=>setTimeout(()=>{if(!done&&!input.files?.length)finish(null)},350),{once:true});
     document.body.appendChild(input);
     input.value='';
     try{input.click()}catch(e){try{input.remove()}catch(_){}reject(e)}
   });
   if(file){AV.loadLocalFile(file);return}
   return;
 }catch(nativeErr){
   console.warn('[Vector] native file input failed',nativeErr);
 }

 // Compatibility fallback for older Core builds.
 try{
   if(typeof window.__alekPickExternalMedia!=='function')throw new Error('File picker is unavailable');
   const r=await window.__alekPickExternalMedia({multiple:false,extensions:['png','jpg','jpeg','webp','bmp']});
   if(!r?.ok){AV.ui.toast(r?.error||'File could not be selected.');return}
   if(r.cancelled)return;
   const f=r.files?.[0];if(f)AV.loadExternalDescriptor(f);
 }catch(e){console.error(e);AV.ui.toast(String(e?.message||e));}
};
})();

(function(){
'use strict';
const AV=window.AV;
AV.traceDim=()=>{
 const img=AV.state.image;if(!img)return{w:1,h:1,scale:1};
 const max=Math.max(img.naturalWidth,img.naturalHeight),q=AV.clamp(Number(AV.state.quality)||0,0,1024),qn=q/1024;
 const lim=q>=1000?Infinity:Math.round(720+Math.pow(qn,1.55)*5280);
 const scale=Number.isFinite(lim)?Math.min(1,lim/max):1;
 return{w:Math.max(1,Math.round(img.naturalWidth*scale)),h:Math.max(1,Math.round(img.naturalHeight*scale)),scale,quality:q};
};
AV.canvasForTrace=()=>{const d=AV.traceDim(),c=document.createElement('canvas');c.width=d.w;c.height=d.h;const ctx=c.getContext('2d',{alpha:true,willReadFrequently:true});ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';ctx.drawImage(AV.state.image,0,0,d.w,d.h);return{canvas:c,ctx,...d}};
AV.blobToBase64=blob=>new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result).split(',')[1]||'');r.onerror=()=>reject(r.error||new Error('Could not read Base64 data'));r.readAsDataURL(blob)});
AV.prepareMonoInput=async()=>{
 const {canvas,ctx,w,h}=AV.canvasForTrace(),id=ctx.getImageData(0,0,w,h),d=id.data,t=AV.clamp(AV.state.threshold,0,1024)*(255/1024),invert=AV.state.invert;
 for(let i=0;i<d.length;i+=4){if(d[i+3]<12)continue;const y=.2126*d[i]+.7152*d[i+1]+.0722*d[i+2];let black=y<t;if(invert)black=!black;const v=black?0:255;d[i]=d[i+1]=d[i+2]=v;d[i+3]=255}
 ctx.putImageData(id,0,0);const blob=await AV.canvasBlob(canvas,'image/png');return{w,h,base64:await AV.blobToBase64(blob)};
};
})();
(function(){
'use strict';
const AV=window.AV;
AV.prepareColorInput=async()=>{
 const {canvas,w,h}=AV.canvasForTrace();
 const blob=await AV.canvasBlob(canvas,'image/png');
 return{w,h,base64:await AV.blobToBase64(blob)};
};
})();

(function(){
'use strict';
const AV=window.AV;
AV.engine={controller:null,baseUrl:'http://127.0.0.1:17324',healthCache:null,healthAt:0};
AV.engine.interrupt=()=>{if(AV.engine.controller){try{AV.engine.controller.abort()}catch(_){}AV.engine.controller=null}};
AV.engine.health=async()=>{
  const now=Date.now();if(AV.engine.healthCache&&now-AV.engine.healthAt<5000)return AV.engine.healthCache;
  const c=new AbortController(),t=setTimeout(()=>c.abort(),3500);
  try{
    const r=await fetch(AV.engine.baseUrl+'/health?ts='+Date.now(),{mode:'cors',cache:'no-store',signal:c.signal});
    if(!r.ok)throw new Error('HTTP '+r.status);
    const j=await r.json();if(!j?.ok)throw new Error('engine_not_ready');
    AV.engine.healthCache=j;AV.engine.healthAt=now;return j;
  }catch(e){
    throw new Error('Could not connect to the engine: '+String(e?.message||e));
  }finally{clearTimeout(t)}
};
AV.engine.run=async({canvas,options,mode})=>{
  await AV.engine.health().catch(e=>{throw new Error('The local Vector engine is unreachable. Run INSTALL_ENGINE.cmd. '+String(e?.message||e))});
  AV.engine.interrupt();
  const c=new AbortController();AV.engine.controller=c;
  const ctx=canvas.getContext('2d',{alpha:true,willReadFrequently:true});
  const img=ctx.getImageData(0,0,canvas.width,canvas.height);
  const p=new URLSearchParams({
    width:String(canvas.width),height:String(canvas.height),mode:mode==='mono'?'mono':'color',
    maxColors:String(options.maxColors),filterSpeckle:String(options.filterSpeckle),
    colorPrecision:String(options.colorPrecision),layerDifference:String(options.layerDifference),
    cornerThreshold:String(options.cornerThreshold),lengthThreshold:String(options.lengthThreshold),
    maxIterations:String(options.maxIterations),spliceThreshold:String(options.spliceThreshold),
    simplify:String(options.simplify),pathPrecision:String(options.pathPrecision),
    optimize:String(options.optimize),binaryThreshold:String(options.binaryThreshold),hierarchical:'stacked'
  });
  try{
    const r=await fetch(AV.engine.baseUrl+'/vectorize?'+p.toString(),{
      method:'POST',mode:'cors',cache:'no-store',signal:c.signal,
      headers:{'Content-Type':'application/octet-stream'},body:img.data.buffer
    });
    const text=await r.text();
    if(!r.ok)throw new Error(text.slice(0,600)||('Vector engine HTTP '+r.status));
    if(!/<svg\b/i.test(text))throw new Error('Engine did not return a valid SVG');
    return{svg:text,w:canvas.width,h:canvas.height};
  }catch(e){
    if(e?.name==='AbortError')throw new Error('trace_cancelled');
    throw e;
  }finally{if(AV.engine.controller===c)AV.engine.controller=null}
};
})();

(function(){
'use strict';
const AV=window.AV,$=AV.$;

AV.engineOptions=()=>{
  const s=AV.state,u=v=>AV.clamp(Number(v)||0,0,1024),n=v=>u(v)/1024;
  const q=n(s.quality),d=n(s.detail),sm=n(s.smoothing),cl=n(s.cleanup);
  const true1024=(Number(s.colors)>=1024)||(Number(s.quality)>=1024);
  const maxColors=true1024?1024:AV.clamp(Math.round(Number(s.colors)||2),2,1024);
  const colorPrecision=8;
  const filterSpeckle=true1024?0:AV.clamp(Math.round(Math.pow(cl,1.45)*12),0,24);
  // Smaller layerDifference = more gradient layers = more photographic fidelity.
  const layerDifference=true1024?0:AV.clamp(Math.round(20-d*17+cl*1.5),2,22);
  const cornerThreshold=true1024?60:AV.clamp(Math.round(36+sm*38-d*5),24,82);
  const lengthThreshold=true1024?3.5:AV.clamp(5.4-d*1.45+sm*.25,3.5,6.0);
  const maxIterations=true1024?32:AV.clamp(Math.round(6+q*9+d*5),6,20);
  const spliceThreshold=true1024?45:AV.clamp(Math.round(30+sm*34+(1-d)*5),28,76);
  const simplify=true1024?0:AV.clamp(.35+sm*1.05+(1-d)*.30,0.35,1.75);
  const pathPrecision=true1024?8:AV.clamp(Math.round(3+q*3),3,6);
  const optimize=true1024?0:1;
  const binaryThreshold=AV.clamp(Math.round(AV.clamp(Number(s.threshold)||512,0,1024)*(255/1024)),0,255);
  return{maxColors,filterSpeckle,colorPrecision,layerDifference,cornerThreshold,lengthThreshold,maxIterations,spliceThreshold,simplify,pathPrecision,optimize,binaryThreshold,true1024};
};

AV.traceKey=()=>AV.state.image?JSON.stringify([
  AV.state.inputPath,AV.state.file?.size,AV.state.mode,AV.state.colors,AV.state.threshold,
  AV.state.detail,AV.state.smoothing,AV.state.cleanup,AV.state.quality,AV.state.background,AV.state.invert,
  AV.engineOptions()
]):'';

AV.schedulePreview=(immediate=false)=>{
  clearTimeout(AV.state.renderTimer);if(!AV.state.image)return;
  AV.state.renderTimer=setTimeout(()=>AV.runPreview(),immediate?0:AV.CONFIG.previewDebounce);
};

AV.cancelTrace=()=>{
  clearTimeout(AV.state.renderTimer);AV.state.pendingTrace=false;AV.state.serial++;
  if(AV.state.busy)AV.engine.interrupt();
};

AV.prepareEngineCanvas=()=>{
  const {canvas,ctx,w,h}=AV.canvasForTrace();
  if(AV.state.mode==='mono'){
    const id=ctx.getImageData(0,0,w,h),d=id.data,t=AV.clamp(AV.state.threshold,0,1024)*(255/1024),invert=AV.state.invert;
    for(let i=0;i<d.length;i+=4){
      if(d[i+3]<12){d[i]=d[i+1]=d[i+2]=255;d[i+3]=255;continue}
      const y=.2126*d[i]+.7152*d[i+1]+.0722*d[i+2];let black=y<t;if(invert)black=!black;
      const v=black?0:255;d[i]=d[i+1]=d[i+2]=v;d[i+3]=255;
    }
    ctx.putImageData(id,0,0);
  }
  return{canvas,w,h};
};

AV.renderPreview=res=>{
  const img=$('.canvas-result');
  if(res.rawOnly){
    $('.result-scene').classList.remove('show');$('.result-empty').style.display='grid';
    $('.result-empty strong').textContent='Full SVG is ready';
    $('.result-empty span').textContent=`${AV.formatBytes(res.size)} of real vector data was generated. This RAW / heavy SVG was not rendered in the preview to avoid locking the WebView; Save SVG will save it unchanged.`;
    return;
  }
  const blob=new Blob([res.svg],{type:'image/svg+xml'}),url=URL.createObjectURL(blob);
  img.onload=()=>URL.revokeObjectURL(url);img.src=url;
  $('.result-scene').classList.add('show');$('.result-empty').style.display='none';
};

AV.runPreview=async()=>{
  if(!AV.state.image)return null;
  const key=AV.traceKey();if(AV.state.preview&&AV.state.previewKey===key)return AV.state.preview;
  if(AV.state.busy){AV.state.pendingTrace=true;return null}
  const t0=AV.now();AV.state.busy=true;AV.state.pendingTrace=false;
  const serial=++AV.state.serial;
  AV.ui.setBusy(true,'Preparing local VTracer engine');AV.ui.setStatus('Generating SVG');AV.syncUI();
  try{
    const prep=AV.prepareEngineCanvas(),options=AV.engineOptions();AV.ui.progress(12,'Ałek image preparation');
    const rr=await AV.engine.run({canvas:prep.canvas,options,mode:AV.state.mode});
    if(serial!==AV.state.serial)return null;
    AV.ui.progress(90,'Ałek SVG validation / refine');
    const rawBytes=new TextEncoder().encode(rr.svg).byteLength;
    let res;
    if(rawBytes>AV.CONFIG.hugeSvgRenderLimit){
      if(/<image\b/i.test(rr.svg))throw new Error('Embedded raster image detected');
      res={svg:rr.svg,size:rawBytes,bytes:rawBytes,rawOnly:true,pathCount:(rr.svg.match(/<path\b/gi)||[]).length,cubicCount:(rr.svg.match(/[cC](?=[\s\d+\-.])/g)||[]).length};
    }else{
      res=AV.refineSvg(rr.svg,{background:AV.state.background,cleanup:AV.state.cleanup});res.size=res.bytes;res.rawOnly=false;
    }
    res.ms=Math.round(AV.now()-t0);res.engine='VisionCortex VTracer 1.0 Photo + Ałek Refine';res.w=prep.w;res.h=prep.h;
    AV.renderPreview(res);AV.state.preview=res;AV.state.lastSuccessfulPreview=res;AV.state.previewKey=key;AV.state.lastTraceMs=res.ms;
    const pc=Number(res.pathCount)||0,cc=Number(res.cubicCount)||0;
    $('.trace-info').textContent=`${prep.w}×${prep.h} · ${pc.toLocaleString('tr-TR')} path · ${cc.toLocaleString('tr-TR')} cubic · ${(res.ms/1000).toFixed(1)} sn`;
    $('.stats').textContent=`VTracer 1.0 Photo + Ałek${options.true1024?' · RAW 1024':''} · ${AV.formatBytes(res.size)}`;AV.ui.setStatus('ready');
    return res;
  }catch(err){
    if(serial!==AV.state.serial||String(err?.message||err)==='trace_cancelled')return null;
    console.error(err);AV.ui.setStatus('error');
    const reason=String(err?.message||err||'').split('\n')[0].slice(0,180);
    AV.ui.toast(AV.state.lastSuccessfulPreview?`New trace failed · previous SVG preserved · ${reason}`:`Could not generate SVG · ${reason}`);
    return null;
  }finally{
    AV.state.busy=false;AV.ui.setBusy(false);AV.syncUI();
    if(AV.state.pendingTrace){AV.state.pendingTrace=false;setTimeout(()=>AV.runPreview(),120)}
  }
};

AV.ensurePreviewCurrent=async()=>{
  clearTimeout(AV.state.renderTimer);
  if(AV.state.preview&&AV.state.previewKey===AV.traceKey())return AV.state.preview;
  await AV.runPreview();
  if(AV.state.preview&&AV.state.previewKey===AV.traceKey())return AV.state.preview;
  throw new Error('No current SVG is available');
};
})();

(function(){
'use strict';
const AV=window.AV;

function parseLength(v){const n=parseFloat(String(v||''));return Number.isFinite(n)?n:0}
function viewBoxSize(svg){
 const vb=(svg.getAttribute('viewBox')||'').trim().split(/[ ,]+/).map(Number);
 if(vb.length===4&&vb.every(Number.isFinite))return{x:vb[0],y:vb[1],w:vb[2],h:vb[3]};
 return{x:0,y:0,w:parseLength(svg.getAttribute('width'))||1,h:parseLength(svg.getAttribute('height'))||1};
}
function fillLuma(el){
 const f=(el.getAttribute('fill')||'').trim();
 const m=/^#([0-9a-f]{6})$/i.exec(f);if(!m)return null;
 const n=parseInt(m[1],16),r=(n>>16)&255,g=(n>>8)&255,b=n&255;return .2126*r+.7152*g+.0722*b;
}
AV.refineSvg=function(svgText,options={}){
 if(!svgText||!/<svg\b/i.test(svgText))throw new Error('Engine did not generate a valid SVG');
 const doc=new DOMParser().parseFromString(svgText,'image/svg+xml');
 if(doc.querySelector('parsererror'))throw new Error('SVG parse edilemedi');
 const svg=doc.documentElement;if(svg.localName!=='svg')throw new Error('SVG root element was not found');
 svg.querySelectorAll('script,foreignObject,image').forEach(n=>n.remove());
 svg.setAttribute('shape-rendering','geometricPrecision');
 svg.setAttribute('data-generator','Ałek’ryŧhæ Vector v0.1.0 · VisionCortex VTracer 1.0');
 svg.querySelectorAll('metadata,title,desc').forEach(n=>n.remove());
 const vb=viewBoxSize(svg),paths=Array.from(svg.querySelectorAll('path'));
 let removedBackground=0,removedInvalid=0;
 const host=document.createElement('div');host.style.cssText='position:fixed;left:-100000px;top:-100000px;width:1px;height:1px;overflow:visible;visibility:hidden;pointer-events:none';
 const live=document.importNode(svg,true);host.appendChild(live);document.body.appendChild(host);
 const livePaths=Array.from(live.querySelectorAll('path'));
 let bgCandidate=null,bgScore=-1;
 for(let i=0;i<livePaths.length;i++){
   const lp=livePaths[i],src=paths[i];
   let b;try{b=lp.getBBox()}catch(_){continue}
   if(!Number.isFinite(b.width)||!Number.isFinite(b.height)||b.width<=0||b.height<=0){src?.remove();removedInvalid++;continue}
   if(options.background){
     const area=(b.width*b.height)/(Math.max(1,vb.w*vb.h));
     const mx=Math.max(2,vb.w*.025),my=Math.max(2,vb.h*.025);
     const touches=(b.x<=vb.x+mx?1:0)+(b.y<=vb.y+my?1:0)+(b.x+b.width>=vb.x+vb.w-mx?1:0)+(b.y+b.height>=vb.y+vb.h-my?1:0);
     const lum=fillLuma(lp);
     const score=area+(touches>=3?.35:0)+(lum!=null&&lum>220?.03:0);
     if(area>.72&&touches>=3&&score>bgScore){bgScore=score;bgCandidate=src}
   }
 }
 host.remove();
 if(options.background&&bgCandidate){bgCandidate.remove();removedBackground=1}
 const finalPaths=Array.from(svg.querySelectorAll('path'));
 const cubic=(new XMLSerializer().serializeToString(svg).match(/[cC](?=[\s\d+\-.])/g)||[]).length;
 const out='<?xml version="1.0" encoding="UTF-8"?>\n'+new XMLSerializer().serializeToString(svg);
 if(/<image\b/i.test(out))throw new Error('Embedded raster image detected');
 return{svg:out,pathCount:finalPaths.length,cubicCount:cubic,removedBackground,removedInvalid,bytes:new TextEncoder().encode(out).byteLength};
};
})();

(function(){
'use strict';
const AV=window.AV;
AV.downloadUrl=(url,name)=>{const a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove()};
AV.exportSvg=async()=>{
 if(!AV.state.image)return;AV.ui.setStatus('Saving SVG');
 let r=null;
 try{r=await AV.ensurePreviewCurrent()}
 catch(e){console.error(e);r=AV.state.lastSuccessfulPreview||AV.state.preview||null;if(!r){AV.ui.setStatus('error');AV.ui.toast('No SVG is available to save.');return}AV.ui.toast('Current trace failed · saving the last successful SVG.')}
 try{
   const name=`${AV.baseName()}-${AV.state.mode==='mono'?'black-white':'color'}.svg`;
   if(r.svg){AV.downloadBlob(new Blob([r.svg],{type:'image/svg+xml'}),name)}
   else if(r.url){AV.downloadUrl(r.url,name)}
   else throw new Error('SVG payload yok');
   AV.ui.setStatus('SVG saved');AV.ui.toast(r.rawOnly?'Large SVG was sent directly to the save operation.':'The validated SVG shown on screen was saved.');
 }catch(e){console.error(e);AV.ui.setStatus('error');AV.ui.toast('Could not save SVG: '+String(e?.message||e).slice(0,100))}
};
})();

(function(){
'use strict';
const AV=window.AV,$=AV.$,$$=AV.$$;
const changed=()=>{AV.state.previewKey='';AV.syncUI()};
const commit=()=>{if(!AV.state.image)return;AV.cancelTrace();AV.schedulePreview(true)};
$$('.mode-btn').forEach(b=>b.addEventListener('click',()=>{if(AV.state.mode===b.dataset.mode)return;AV.cancelTrace();AV.state.mode=b.dataset.mode;changed();AV.schedulePreview(true)}));
for(const k of ['colors','threshold','detail','smoothing','cleanup','quality']){
 const el=$('.'+k);if(!el)continue;
 el.addEventListener('pointerdown',()=>{AV.state.adjusting=true;if(AV.state.busy)AV.cancelTrace()});
 el.addEventListener('input',e=>{AV.state[k]=+e.target.value;changed()});
 const finish=()=>{if(!AV.state.adjusting)return;AV.state.adjusting=false;commit()};
 el.addEventListener('change',finish);
 el.addEventListener('pointerup',finish);
}
$('.background').addEventListener('click',()=>{AV.cancelTrace();AV.state.background=!AV.state.background;changed();AV.schedulePreview(true)});
$('.invert').addEventListener('click',()=>{AV.cancelTrace();AV.state.invert=!AV.state.invert;changed();AV.schedulePreview(true)});
$$('.pick').forEach(b=>b.addEventListener('click',AV.pickImage));
const drop=$('.source-drop');
['dragenter','dragover','dragleave','drop'].forEach(t=>drop.addEventListener(t,e=>{e.preventDefault();drop.classList.toggle('drag',t==='dragenter'||t==='dragover')}));
drop.addEventListener('drop',e=>{const f=e.dataTransfer?.files?.[0];if(f)AV.loadLocalFile(f)});
$$('.save').forEach(b=>b.addEventListener('click',AV.exportSvg));
AV.exitApp=()=>{try{if(typeof window.__alekAPI==='function'){window.__alekAPI('app.exit',{});return}}catch(_){}try{if(window.chrome?.webview?.postMessage){window.chrome.webview.postMessage({op:'app.exit'});return}}catch(_){}try{window.close()}catch(_){}};
$('.exit-app').addEventListener('click',AV.exitApp);
window.addEventListener('keydown',e=>{if(e.key==='Escape'&&!AV.state.introDone)AV.dismissSplash();if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='o'){e.preventDefault();AV.pickImage()}if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();AV.exportSvg()}if(e.altKey&&e.key==='F4'){e.preventDefault();AV.exitApp()}});
document.addEventListener('visibilitychange',()=>{if(document.hidden&&AV.state.busy)AV.cancelTrace()});
})();

(function(){
'use strict';
const AV=window.AV;
AV.syncUI();AV.ui.setStatus('ready');
(async()=>{
 try{
   // v3.1.1 uses the browser/WebView native file picker first.
   // Core media picker is now only a compatibility fallback.
   AV.state.engineStatus='ready';
   try{
     if(typeof window.__alekAPI==='function'){
       const g=await window.__alekAPI('getGraphicsPreference',{});
       AV.state.perf.gpuPreference=g?.config?.Preference||g?.config?.preference||'';
     }
   }catch(_){}
   console.info('[Vector v3.1.1]',{engine:'VTracer Native + Ałek Refine',cores:AV.state.perf.cores,memoryGB:AV.state.perf.memory,gpu:AV.state.perf.gpuPreference||'Core automatic'});
 }catch(e){console.error(e);AV.state.engineStatus='error'}
})();
console.info(`Ałek’ryŧhæ Vector ${AV.VERSION} ${AV.BUILD}`);
})();
